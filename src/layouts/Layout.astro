---
import "../styles/global.css";

const {pageTitle} = Astro.props 
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="" />            <!-- Descripción de la página -->

    <meta property="og:url" content="" />             <!-- URL de la página -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="" />           <!-- Título de la página -->
    <meta property="og:description" content="" />     <!-- Descripción de la página -->
    <meta property="og:image" content="/images/" />   <!-- Imagen representativa de la página -->

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="" />        <!-- Dominio del sitio -->
    <meta property="twitter:url" content="" />           <!-- URL de la página -->
    <meta name="twitter:title" content="" />             <!-- Título de la página -->
    <meta name="twitter:description" content="" />       <!-- Descripción de la página -->
    <meta name="twitter:image" content="/images/" />     <!-- Imagen representativa de la página -->
  
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
